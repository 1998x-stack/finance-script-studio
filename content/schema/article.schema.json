{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1998x-stack.github.io/finance-script-studio/article.schema.json",
  "title": "Finance Script Studio article v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "title",
    "subtitle",
    "lead",
    "category",
    "status",
    "published_at",
    "updated_at",
    "as_of",
    "reading_minutes",
    "video_seconds",
    "keywords",
    "summary",
    "key_numbers",
    "takeaways",
    "sections",
    "voiceover",
    "sources",
    "fact_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "subtitle": {
      "type": "string",
      "minLength": 8
    },
    "lead": {
      "type": "string",
      "minLength": 16
    },
    "category": {
      "enum": [
        "event",
        "company",
        "policy",
        "concept"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "reading_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "video_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 180
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "key_numbers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value",
          "unit",
          "period",
          "detail",
          "source_ids"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "source_ids": {
            "$ref": "#/$defs/sourceIds"
          }
        }
      }
    },
    "takeaways": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "title",
        "items",
        "note",
        "source_ids"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label",
              "amount",
              "display"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "display": {
                "type": "string"
              }
            }
          }
        },
        "note": {
          "type": "string"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "paragraphs"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "source_ids"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "source_ids": {
                  "$ref": "#/$defs/sourceIds"
                }
              }
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "voiceover": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "stage",
          "text",
          "shot"
        ],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "shot": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "published_at",
          "type",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "fact_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "status",
          "source_ids"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "attributed",
              "analysis",
              "scenario"
            ]
          },
          "source_ids": {
            "$ref": "#/$defs/sourceIds"
          }
        }
      }
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}